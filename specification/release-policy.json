{
  "schema_version": "1.1",
  "name": "organization-release",
  "version": "1.1.0",
  "dataset_version": "1.1.0",
  "required_variants": ["with-skill", "without-skill"],
  "gated_variant": "with-skill",
  "minimum_replicates": 3,
  "activation": {
    "minimum_precision": 0.9,
    "minimum_recall": 0.9,
    "minimum_specificity": 0.9,
    "minimum_balanced_accuracy": 0.9,
    "minimum_accuracy": 0.9,
    "maximum_false_positive_rate": 0.1,
    "minimum_slice_accuracy": 0.75,
    "maximum_slice_false_positive_rate": 0.25
  },
  "behavior": {
    "minimum_pass_rate": 0.9,
    "minimum_case_pass_rate": 0.85,
    "minimum_decision_exact_match_rate": 0.85,
    "minimum_slice_observations": 3,
    "minimum_slice_pass_rate": 0.75,
    "maximum_ungraded": 0
  },
  "review": {
    "minimum_reviews_per_candidate": 2,
    "minimum_raw_grade_agreement": 0.8,
    "minimum_chance_corrected_grade_agreement": 0.6,
    "minimum_decision_set_agreement": 0.8
  },
  "pairwise": {
    "minimum_resolved_fraction": 0.95,
    "minimum_with_skill_win_rate_excluding_ties": 0.55,
    "minimum_raw_reviewer_agreement": 0.8
  },
  "comparison": {
    "baseline_variant": "without-skill",
    "minimum_activation_accuracy_delta": 0.01,
    "minimum_activation_accuracy_lower_bound": -0.05,
    "minimum_behavior_pass_rate_delta": 0.01,
    "minimum_behavior_pass_rate_lower_bound": -0.05
  },
  "required_implementation_fields": [
    "adapter", "adapter_version", "agent", "agent_version", "model", "model_version", "reasoning"
  ]
}
