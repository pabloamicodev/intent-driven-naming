{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-driven-naming.dev/schemas/audit-result.schema.json",
  "title": "Intent-Driven Naming Audit Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "summary", "records", "verification"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "mode": { "enum": ["audit", "refactor"] },
    "summary": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "semantic-record.schema.json" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "contract_checks", "unverified_surfaces"],
      "properties": {
        "commands": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "contract_checks": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unverified_surfaces": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
