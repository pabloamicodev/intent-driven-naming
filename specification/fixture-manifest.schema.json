{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-driven-naming.dev/schemas/fixture-manifest.schema.json",
  "title": "Executable Fixture Manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "fixtures"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "fixtures": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "id", "language", "related_behavior_cases", "expected_decisions",
          "directory", "candidate_filename", "reference",
          "critical", "verify_command", "timeout_seconds"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^FX[0-9]{2}$" },
          "language": { "type": "string", "minLength": 1 },
          "related_behavior_cases": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^B[0-9]{2}$" }
          },
          "expected_decisions": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "enum": ["keep", "rename", "map", "migrate", "defer", "not-applicable"] }
          },
          "directory": { "type": "string", "minLength": 1 },
          "candidate_filename": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 },
          "critical": { "type": "boolean" },
          "required_tool": { "type": "string", "minLength": 1 },
          "verify_command": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 }
        }
      }
    }
  }
}
