{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-driven-naming.dev/schemas/release-policy.schema.json",
  "title": "Intent-Driven Naming Release Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "required_variants",
    "gated_variant",
    "activation_minimums",
    "behavior",
    "comparison",
    "required_implementation_fields"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "required_variants": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["with-skill", "without-skill"] }
    },
    "gated_variant": { "enum": ["with-skill", "without-skill"] },
    "activation_minimums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "recall", "accuracy"],
      "properties": {
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "accuracy": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_pass_rate", "maximum_ungraded"],
      "properties": {
        "minimum_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximum_ungraded": { "type": "integer", "minimum": 0 }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_variant",
        "minimum_activation_accuracy_delta",
        "minimum_behavior_pass_rate_delta"
      ],
      "properties": {
        "baseline_variant": { "enum": ["with-skill", "without-skill"] },
        "minimum_activation_accuracy_delta": { "type": "number" },
        "minimum_behavior_pass_rate_delta": { "type": "number" }
      }
    },
    "required_implementation_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
