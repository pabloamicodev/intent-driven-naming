{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-driven-naming.dev/schemas/release-policy.schema.json",
  "title": "Intent-Driven Naming Release Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "name", "version", "dataset_version", "required_variants",
    "gated_variant", "minimum_systems", "minimum_replicates", "experiment",
    "activation", "behavior", "review", "pairwise",
    "comparison", "efficiency", "required_implementation_fields"
  ],
  "$defs": {
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "positiveRatio": { "type": "number", "exclusiveMinimum": 0 }
  },
  "properties": {
    "schema_version": { "const": "2.0" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "dataset_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "required_variants": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": { "enum": ["with-skill", "previous-skill", "without-skill"] }
    },
    "gated_variant": { "const": "with-skill" },
    "minimum_systems": { "type": "integer", "minimum": 3 },
    "minimum_replicates": { "type": "integer", "minimum": 3 },
    "experiment": {
      "type": "object", "additionalProperties": false,
      "required": [
        "require_verified_preregistration", "require_release_candidate",
        "require_held_out_dataset"
      ],
      "properties": {
        "require_verified_preregistration": { "const": true },
        "require_release_candidate": { "const": true },
        "require_held_out_dataset": { "const": true }
      }
    },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "minimum_precision", "minimum_recall", "minimum_specificity",
        "minimum_balanced_accuracy", "minimum_accuracy", "maximum_false_positive_rate",
        "minimum_slice_accuracy", "maximum_slice_false_positive_rate"
      ],
      "properties": {
        "minimum_precision": { "$ref": "#/$defs/ratio" },
        "minimum_recall": { "$ref": "#/$defs/ratio" },
        "minimum_specificity": { "$ref": "#/$defs/ratio" },
        "minimum_balanced_accuracy": { "$ref": "#/$defs/ratio" },
        "minimum_accuracy": { "$ref": "#/$defs/ratio" },
        "maximum_false_positive_rate": { "$ref": "#/$defs/ratio" },
        "minimum_slice_accuracy": { "$ref": "#/$defs/ratio" },
        "maximum_slice_false_positive_rate": { "$ref": "#/$defs/ratio" }
      }
    },
    "behavior": {
      "type": "object", "additionalProperties": false,
      "required": [
        "minimum_pass_rate", "minimum_case_pass_rate", "minimum_decision_exact_match_rate",
        "minimum_slice_observations", "minimum_slice_pass_rate", "maximum_ungraded"
      ],
      "properties": {
        "minimum_pass_rate": { "$ref": "#/$defs/ratio" },
        "minimum_case_pass_rate": { "$ref": "#/$defs/ratio" },
        "minimum_decision_exact_match_rate": { "$ref": "#/$defs/ratio" },
        "minimum_slice_observations": { "type": "integer", "minimum": 1 },
        "minimum_slice_pass_rate": { "$ref": "#/$defs/ratio" },
        "maximum_ungraded": { "type": "integer", "minimum": 0 }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": [
        "minimum_reviews_per_candidate", "minimum_human_reviews_per_candidate", "minimum_raw_grade_agreement",
        "minimum_chance_corrected_grade_agreement", "minimum_decision_set_agreement"
      ],
      "properties": {
        "minimum_reviews_per_candidate": { "type": "integer", "minimum": 2 },
        "minimum_human_reviews_per_candidate": { "type": "integer", "minimum": 2 },
        "minimum_raw_grade_agreement": { "$ref": "#/$defs/ratio" },
        "minimum_chance_corrected_grade_agreement": { "type": "number", "minimum": -1, "maximum": 1 },
        "minimum_decision_set_agreement": { "$ref": "#/$defs/ratio" }
      }
    },
    "pairwise": {
      "type": "object", "additionalProperties": false,
      "required": [
        "minimum_resolved_fraction", "minimum_with_skill_win_rate_excluding_ties",
        "minimum_raw_reviewer_agreement", "minimum_human_reviews_per_pair"
      ],
      "properties": {
        "minimum_resolved_fraction": { "$ref": "#/$defs/ratio" },
        "minimum_with_skill_win_rate_excluding_ties": { "$ref": "#/$defs/ratio" },
        "minimum_raw_reviewer_agreement": { "$ref": "#/$defs/ratio" },
        "minimum_human_reviews_per_pair": { "type": "integer", "minimum": 2 }
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": [
        "baseline_variant", "minimum_activation_accuracy_delta",
        "minimum_activation_accuracy_lower_bound", "minimum_behavior_pass_rate_delta",
        "minimum_behavior_pass_rate_lower_bound"
      ],
      "properties": {
        "baseline_variant": { "const": "without-skill" },
        "minimum_activation_accuracy_delta": { "type": "number" },
        "minimum_activation_accuracy_lower_bound": { "type": "number" },
        "minimum_behavior_pass_rate_delta": { "type": "number" },
        "minimum_behavior_pass_rate_lower_bound": { "type": "number" }
      }
    },
    "efficiency": {
      "type": "object", "additionalProperties": false,
      "required": [
        "comparison_variant", "required_usage_fields", "minimum_resource_reporting_rate",
        "minimum_core_resource_rate", "maximum_unknown_resources",
        "maximum_unnecessary_resources", "maximum_overloaded_profile_results",
        "maximum_unexpected_activation_resource_results", "maximum_input_token_ratio",
        "maximum_output_token_ratio", "maximum_latency_ratio", "maximum_skill_context_word_ratio",
        "maximum_turn_ratio", "maximum_tool_call_ratio", "maximum_standard_route_words",
        "maximum_extended_route_words", "maximum_runtime_instruction_words",
        "maximum_standard_route_bytes", "maximum_extended_route_bytes",
        "maximum_runtime_instruction_bytes"
      ],
      "properties": {
        "comparison_variant": { "const": "previous-skill" },
        "required_usage_fields": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "enum": [
              "input_tokens", "output_tokens", "latency_ms", "skill_context_words", "turns", "tool_calls"
            ]
          }
        },
        "minimum_resource_reporting_rate": { "$ref": "#/$defs/ratio" },
        "minimum_core_resource_rate": { "$ref": "#/$defs/ratio" },
        "maximum_unknown_resources": { "type": "integer", "minimum": 0 },
        "maximum_unnecessary_resources": { "type": "integer", "minimum": 0 },
        "maximum_overloaded_profile_results": { "type": "integer", "minimum": 0 },
        "maximum_unexpected_activation_resource_results": { "type": "integer", "minimum": 0 },
        "maximum_input_token_ratio": { "$ref": "#/$defs/positiveRatio" },
        "maximum_output_token_ratio": { "$ref": "#/$defs/positiveRatio" },
        "maximum_latency_ratio": { "$ref": "#/$defs/positiveRatio" },
        "maximum_skill_context_word_ratio": { "$ref": "#/$defs/positiveRatio" },
        "maximum_turn_ratio": { "$ref": "#/$defs/positiveRatio" },
        "maximum_tool_call_ratio": { "$ref": "#/$defs/positiveRatio" },
        "maximum_standard_route_words": { "type": "integer", "minimum": 1 },
        "maximum_extended_route_words": { "type": "integer", "minimum": 1 },
        "maximum_runtime_instruction_words": { "type": "integer", "minimum": 1 },
        "maximum_standard_route_bytes": { "type": "integer", "minimum": 1 },
        "maximum_extended_route_bytes": { "type": "integer", "minimum": 1 },
        "maximum_runtime_instruction_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "required_implementation_fields": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
