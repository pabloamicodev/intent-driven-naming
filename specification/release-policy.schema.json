{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-driven-naming.dev/schemas/release-policy.schema.json",
  "title": "Intent-Driven Naming Release Policy",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "name", "version", "dataset_version", "required_variants",
    "gated_variant", "minimum_replicates", "activation", "behavior", "review", "pairwise",
    "comparison", "required_implementation_fields"
  ],
  "$defs": {
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "properties": {
    "schema_version": { "const": "1.1" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "dataset_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "required_variants": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": { "enum": ["with-skill", "without-skill"] }
    },
    "gated_variant": { "enum": ["with-skill", "without-skill"] },
    "minimum_replicates": { "type": "integer", "minimum": 1 },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "minimum_precision", "minimum_recall", "minimum_specificity",
        "minimum_balanced_accuracy", "minimum_accuracy", "maximum_false_positive_rate",
        "minimum_slice_accuracy", "maximum_slice_false_positive_rate"
      ],
      "properties": {
        "minimum_precision": { "$ref": "#/$defs/ratio" },
        "minimum_recall": { "$ref": "#/$defs/ratio" },
        "minimum_specificity": { "$ref": "#/$defs/ratio" },
        "minimum_balanced_accuracy": { "$ref": "#/$defs/ratio" },
        "minimum_accuracy": { "$ref": "#/$defs/ratio" },
        "maximum_false_positive_rate": { "$ref": "#/$defs/ratio" },
        "minimum_slice_accuracy": { "$ref": "#/$defs/ratio" },
        "maximum_slice_false_positive_rate": { "$ref": "#/$defs/ratio" }
      }
    },
    "behavior": {
      "type": "object", "additionalProperties": false,
      "required": [
        "minimum_pass_rate", "minimum_case_pass_rate",
        "minimum_decision_exact_match_rate", "minimum_slice_observations",
        "minimum_slice_pass_rate", "maximum_ungraded"
      ],
      "properties": {
        "minimum_pass_rate": { "$ref": "#/$defs/ratio" },
        "minimum_case_pass_rate": { "$ref": "#/$defs/ratio" },
        "minimum_decision_exact_match_rate": { "$ref": "#/$defs/ratio" },
        "minimum_slice_observations": { "type": "integer", "minimum": 1 },
        "minimum_slice_pass_rate": { "$ref": "#/$defs/ratio" },
        "maximum_ungraded": { "type": "integer", "minimum": 0 }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": [
        "minimum_reviews_per_candidate", "minimum_raw_grade_agreement",
        "minimum_chance_corrected_grade_agreement", "minimum_decision_set_agreement"
      ],
      "properties": {
        "minimum_reviews_per_candidate": { "type": "integer", "minimum": 1 },
        "minimum_raw_grade_agreement": { "$ref": "#/$defs/ratio" },
        "minimum_chance_corrected_grade_agreement": { "type": "number", "minimum": -1, "maximum": 1 },
        "minimum_decision_set_agreement": { "$ref": "#/$defs/ratio" }
      }
    },
    "pairwise": {
      "type": "object", "additionalProperties": false,
      "required": [
        "minimum_resolved_fraction", "minimum_with_skill_win_rate_excluding_ties",
        "minimum_raw_reviewer_agreement"
      ],
      "properties": {
        "minimum_resolved_fraction": { "$ref": "#/$defs/ratio" },
        "minimum_with_skill_win_rate_excluding_ties": { "$ref": "#/$defs/ratio" },
        "minimum_raw_reviewer_agreement": { "$ref": "#/$defs/ratio" }
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": [
        "baseline_variant", "minimum_activation_accuracy_delta",
        "minimum_activation_accuracy_lower_bound", "minimum_behavior_pass_rate_delta",
        "minimum_behavior_pass_rate_lower_bound"
      ],
      "properties": {
        "baseline_variant": { "enum": ["with-skill", "without-skill"] },
        "minimum_activation_accuracy_delta": { "type": "number" },
        "minimum_activation_accuracy_lower_bound": { "type": "number" },
        "minimum_behavior_pass_rate_delta": { "type": "number" },
        "minimum_behavior_pass_rate_lower_bound": { "type": "number" }
      }
    },
    "required_implementation_fields": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
