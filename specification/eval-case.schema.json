{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-driven-naming.dev/schemas/eval-case.schema.json",
  "title": "Intent-Driven Naming Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dataset_version", "id", "suite", "title", "prompt",
    "difficulty", "locale", "tags"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "dataset_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^[TB][0-9]{2}$" },
    "suite": { "enum": ["activation", "behavior"] },
    "title": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "difficulty": { "enum": ["easy", "standard", "edge", "adversarial"] },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "tags": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "expected_activation": { "type": "boolean" },
    "rationale": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["generation", "audit", "refactor"] },
    "languages": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "contract_risk": {
      "enum": ["internal", "cross-module", "external", "dynamic", "stateful", "unknown"]
    },
    "expected_decisions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["keep", "rename", "map", "migrate", "defer", "not-applicable"] }
    },
    "invariants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "severity", "grading"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "major", "minor"] },
          "grading": { "enum": ["deterministic", "semantic", "human"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "suite": { "const": "activation" } }, "required": ["suite"] },
      "then": { "required": ["expected_activation", "rationale"] }
    },
    {
      "if": { "properties": { "suite": { "const": "behavior" } }, "required": ["suite"] },
      "then": { "required": ["mode", "languages", "contract_risk", "expected_decisions", "invariants"] }
    }
  ]
}
