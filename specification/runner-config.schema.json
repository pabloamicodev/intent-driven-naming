{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-driven-naming.dev/schemas/runner-config.schema.json",
  "title": "Local Experiment Runner Configuration",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "output_root", "current_skill_path", "baseline_skill_path",
    "release_policy_path", "datasets", "adapters", "limits"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "output_root": { "type": "string", "minLength": 1 },
    "current_skill_path": { "type": "string", "minLength": 1 },
    "baseline_skill_path": { "type": "string", "minLength": 1 },
    "release_policy_path": { "type": "string", "minLength": 1 },
    "datasets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dataset_id", "activation_cases", "behavior_cases"],
        "properties": {
          "dataset_id": { "type": "string", "minLength": 1 },
          "activation_cases": { "type": "string", "minLength": 1 },
          "behavior_cases": { "type": "string", "minLength": 1 }
        }
      }
    },
    "adapters": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["system_id", "command"],
        "properties": {
          "system_id": { "type": "string", "minLength": 1 },
          "command": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": [
        "max_workers", "timeout_seconds", "max_input_bytes", "max_output_bytes",
        "max_stderr_bytes"
      ],
      "properties": {
        "max_workers": { "type": "integer", "minimum": 1, "maximum": 16 },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "max_input_bytes": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "max_stderr_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
