{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-driven-naming.dev/schemas/rename-plan.schema.json",
  "title": "Intent-Driven Naming Rename Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "scope", "authorization", "records", "verification"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "plan_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "migration_authorized"],
      "properties": {
        "mode": { "enum": ["refactor", "migration"] },
        "migration_authorized": { "type": "boolean" }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "semantic-record.schema.json" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "contract_checks"],
      "properties": {
        "commands": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "contract_checks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
