{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-driven-naming.dev/schemas/rename-plan.schema.json",
  "title": "Intent-Driven Naming Rename Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "scope", "authorization", "analysis", "records", "verification"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "plan_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "migration_authorized", "maximum_changed_symbols"],
      "properties": {
        "mode": { "enum": ["refactor", "migration"] },
        "migration_authorized": { "type": "boolean" },
        "maximum_changed_symbols": { "type": "integer", "minimum": 0, "maximum": 500 }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "reference_coverage", "dynamic_surfaces_checked"],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["symbol-graph", "language-server", "compiler-index", "ast", "text-search", "manual"]
          }
        },
        "reference_coverage": { "enum": ["complete", "partial", "unknown"] },
        "dynamic_surfaces_checked": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "semantic-record.schema.json" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "contract_checks", "collision_checks", "rollback_commands"],
      "properties": {
        "commands": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "contract_checks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "collision_checks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "rollback_commands": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "records": { "contains": { "properties": { "decision": { "enum": ["rename", "map", "migrate"] } } } }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "commands": { "minItems": 1 },
              "collision_checks": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "records": {
            "contains": {
              "allOf": [
                { "properties": { "decision": { "enum": ["rename", "map", "migrate"] } } },
                { "properties": { "contract_risk": { "enum": ["cross-module", "external", "dynamic", "generated", "stateful"] } } }
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "analysis": { "properties": { "reference_coverage": { "const": "complete" } } },
          "verification": { "properties": { "contract_checks": { "minItems": 1 } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "records": { "contains": { "properties": { "decision": { "const": "migrate" } } } }
        }
      },
      "then": {
        "properties": {
          "authorization": {
            "properties": { "mode": { "const": "migration" }, "migration_authorized": { "const": true } }
          },
          "verification": { "properties": { "rollback_commands": { "minItems": 1 } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "records": {
            "contains": {
              "allOf": [
                { "properties": { "decision": { "enum": ["map", "migrate"] } } },
                { "properties": { "contract_risk": { "const": "dynamic" } } }
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "analysis": { "properties": { "dynamic_surfaces_checked": { "minItems": 1 } } }
        }
      }
    }
  ]
}
