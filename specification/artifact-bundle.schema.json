{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-driven-naming.dev/schemas/artifact-bundle.schema.json",
  "title": "Sanitized Evaluation Artifact Bundle",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "root_label", "total_bytes", "files"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "root_label": { "type": "string", "minLength": 1 },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "content"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "content": { "type": "string" }
        }
      }
    },
    "verifier_report": { "type": "object" }
  }
}
