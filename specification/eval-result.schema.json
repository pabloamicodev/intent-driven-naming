{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-driven-naming.dev/schemas/eval-result.schema.json",
  "title": "Intent-Driven Naming Evaluation Result",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "protocol_version", "dataset_version", "run_id", "system_id",
    "configuration_hash", "replicate_id", "attempt", "case_id", "variant", "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "protocol_version": { "const": 1 },
    "dataset_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "system_id": { "type": "string", "minLength": 1 },
    "configuration_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "replicate_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "case_id": { "type": "string", "pattern": "^[TB][0-9]{2}$" },
    "variant": { "enum": ["with-skill", "without-skill"] },
    "status": { "enum": ["completed", "failed", "skipped"] },
    "selected_skill": { "type": ["boolean", "null"] },
    "output_text": { "type": ["string", "null"] },
    "artifact_path": { "type": ["string", "null"] },
    "artifact_bundle": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "enum": ["unified-diff", "directory", "none"] },
        "path": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "verifier_report_path": { "type": ["string", "null"] }
      }
    },
    "loaded_resources": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "observed_decisions": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["keep", "rename", "map", "migrate", "defer", "not-applicable"] }
    },
    "invariant_grades": {
      "type": "object",
      "additionalProperties": { "enum": ["pass", "fail", "not-applicable"] }
    },
    "grader_notes": { "type": ["string", "null"] },
    "usage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "error": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": {
        "required": ["error"],
        "properties": { "error": { "type": "string", "minLength": 1 } }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "completed" },
          "case_id": { "pattern": "^T" }
        },
        "required": ["status", "case_id"]
      },
      "then": {
        "required": ["selected_skill"],
        "properties": { "selected_skill": { "type": "boolean" } }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "completed" },
          "case_id": { "pattern": "^B" }
        },
        "required": ["status", "case_id"]
      },
      "then": {
        "anyOf": [
          {
            "required": ["output_text"],
            "properties": { "output_text": { "type": "string", "minLength": 1 } }
          },
          {
            "required": ["artifact_bundle"],
            "properties": {
              "artifact_bundle": {
                "type": "object",
                "properties": { "format": { "enum": ["unified-diff", "directory"] } }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "artifact_bundle": {
            "type": "object",
            "properties": { "format": { "enum": ["unified-diff", "directory"] } },
            "required": ["format"]
          }
        },
        "required": ["artifact_bundle"]
      },
      "then": {
        "properties": {
          "artifact_bundle": {
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  ]
}
