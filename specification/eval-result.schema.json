{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-driven-naming.dev/schemas/eval-result.schema.json",
  "title": "Intent-Driven Naming Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "case_id", "variant", "status"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "protocol_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "pattern": "^[TB][0-9]{2}$" },
    "variant": { "enum": ["with-skill", "without-skill"] },
    "status": { "enum": ["completed", "failed", "skipped"] },
    "selected_skill": { "type": ["boolean", "null"] },
    "output_text": { "type": ["string", "null"] },
    "artifact_path": { "type": ["string", "null"] },
    "invariant_grades": {
      "type": "object",
      "additionalProperties": { "enum": ["pass", "fail", "not-applicable"] }
    },
    "grader_notes": { "type": ["string", "null"] },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "error": { "type": ["string", "null"] }
  }
}
