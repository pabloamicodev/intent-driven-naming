{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-driven-naming.dev/schemas/semantic-record.schema.json",
  "title": "Intent-Driven Naming Semantic Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symbol_id", "identifier", "symbol_kind", "location", "meaning", "evidence",
    "wrong_read", "materiality", "decision", "proposed_name", "confidence", "contract_risk",
    "protected_spellings", "unresolved_surfaces"
  ],
  "properties": {
    "symbol_id": { "type": "string", "minLength": 1 },
    "identifier": { "type": "string", "minLength": 1 },
    "symbol_kind": {
      "enum": [
        "callable", "parameter", "local", "field", "property", "type", "type-parameter",
        "constant", "enum", "variant", "module", "package", "namespace", "event", "message",
        "query", "schema", "infrastructure", "other"
      ]
    },
    "location": { "type": "string", "minLength": 1 },
    "meaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept"],
      "properties": {
        "concept": { "type": "string", "minLength": 1 },
        "role": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "representation": { "type": ["string", "null"] },
        "cardinality": { "type": ["string", "null"] },
        "unit_or_basis": { "type": ["string", "null"] },
        "ownership_or_trust": { "type": ["string", "null"] },
        "effect": { "type": ["string", "null"] },
        "scope": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "fact"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "fact": { "type": "string", "minLength": 1 }
        }
      }
    },
    "wrong_read": { "type": ["string", "null"] },
    "materiality": { "enum": ["none", "low", "material", "critical"] },
    "decision": { "enum": ["keep", "rename", "map", "migrate", "defer"] },
    "proposed_name": { "type": ["string", "null"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "contract_risk": {
      "enum": ["internal", "cross-module", "external", "dynamic", "generated", "stateful", "unknown"]
    },
    "protected_spellings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolved_surfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "enum": ["rename", "map", "migrate"] } } },
      "then": {
        "properties": {
          "wrong_read": { "type": "string", "minLength": 1 },
          "materiality": { "enum": ["material", "critical"] },
          "proposed_name": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["high", "medium"] },
          "unresolved_surfaces": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "enum": ["keep", "defer"] } } },
      "then": { "properties": { "proposed_name": { "type": "null" } } }
    },
    {
      "if": { "properties": { "decision": { "const": "map" } } },
      "then": { "properties": { "protected_spellings": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "decision": { "const": "rename" } } },
      "then": { "properties": { "contract_risk": { "enum": ["internal", "cross-module"] } } }
    },
    {
      "if": { "properties": { "contract_risk": { "const": "unknown" } } },
      "then": { "properties": { "decision": { "enum": ["keep", "defer"] } } }
    }
  ]
}
